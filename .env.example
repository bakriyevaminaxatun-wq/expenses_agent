# Bu faylı ".env" adı ilə kopyalayın və dəyərləri doldurun.
# .env faylını GitHub-a YÜKLƏMƏYİN (.gitignore-da var).

# --- Pulsuz API açarları (ən azı birini yazın; nə qədər çox olsa, limit o qədər gec dolur) ---
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:          https://console.groq.com/keys   (Avtomatik rejimdə router da Groq ilə işləyir)
GROQ_API_KEY=
# OpenRouter:    https://openrouter.ai/settings/keys  (ehtiyat model; digərləri limitə düşəndə işləyir)
OPENROUTER_API_KEY=

# --- Claude (ÖDƏNİŞLİ, ən ucuz model: Haiku 5.5, ~0.1 sent/mesaj) ---
# Açar: https://console.anthropic.com/settings/keys  (sk-ant-... ilə başlayır)
# Yan paneldə "Claude Haiku 5.5" seçəndə işləyir. Avtomatik rejim onu seçmir.
ANTHROPIC_API_KEY=
# Pulsuz modellərin limiti dolanda Claude ehtiyat kimi avtomatik işləsin? (true / false)
ANTHROPIC_AS_FALLBACK=false
# Model (default: claude-haiku-5-5) və qiymət (USD / 1M token) — xərc hesablamaq üçün
ANTHROPIC_MODEL=
ANTHROPIC_PRICE_INPUT=0.10
ANTHROPIC_PRICE_OUTPUT=0.50

# --- Valyuta məzənnəsi (istəyə görə) ---
# currencylayer.com açarı: https://currencylayer.com/dashboard  (pulsuz: ayda 100 sorğu, USD bazası)
# Boş qalsa, Azərbaycan Mərkəzi Bankının (CBAR) rəsmi məzənnəsi istifadə olunur.
# Məzənnə gündə bir dəfə yüklənir və data/rates_cache.json-da saxlanılır.
CURRENCYLAYER_API_KEY=

# --- Model seçimi ---
# Tətbiq açılanda hansı rejim seçili olsun: auto (agent seçir) | gemini | groq | openrouter | anthropic
# (İstifadəçi istənilən vaxt yan paneldən dəyişə bilər.)
DEFAULT_MODEL_CHOICE=auto

# Model adlarını dəyişmək üçün (boş qalsa default istifadə olunur):
#   GEMINI_MODEL default: gemini-flash-latest        (alternativ: gemini-flash-lite-latest)
#   GROQ_MODEL   default: openai/gpt-oss-120b        (alternativ: llama-3.3-70b-versatile)
#   OPENROUTER_MODEL default: openrouter/free        (uyğun pulsuz modeli OpenRouter özü seçir;
#                                                  konkret model üçün adı ":free" ilə yazın)
#   ROUTER_MODEL default: llama-3.1-8b-instant       (Avtomatik rejimdə seçimi edən kiçik model)
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
ROUTER_MODEL=

# --- Limitə qənaət ---
# Modelə göndərilən son mesajların sayı (az olsa, token az xərclənir)
MAX_HISTORY_MESSAGES=24
# Limitə düşən model neçə saniyə istifadə olunmasın
MODEL_COOLDOWN_SECONDS=60

# --- Digər parametrlər ---
# Büdcənin neçə faizində xəbərdarlıq göndərilsin (default: 80)
BUDGET_WARNING_PERCENT=80

# Bir xərc üçün maksimum məbləğ (bundan böyükdürsə agent təsdiq istəyir)
MAX_SINGLE_AMOUNT=10000

# Agent dövründə maksimum addım sayı
MAX_AGENT_STEPS=8

# Saat qurşağı
APP_TIMEZONE=Asia/Baku

# Telegram bildirişləri (boş qalsa, bildiriş yalnız tətbiqdə görünür)
# Bot yaratmaq: Telegram-da @BotFather ; chat id: @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
